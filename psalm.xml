<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="true"
    findDeadCode="true"
    showInfo="true"
>
    <projectFiles>
        <directory name="." />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <reporting>
        <report format="xml" output="build/reports/psalm.xml"/>
    </reporting>
</psalm>