	$(".location-main").click(function() {
		$(this).addClass('active').siblings().removeClass('active');
		$('body').addClass('index-mask');
		// console.log($(this).attr("data-num"));
		var num = $(this).attr("data-num");
		for (i = 0; i < $('.map-box').length; i++) {
			var el = $('.map-box')[i]
			// console.log($(el).attr("data-num"));
			if ($(el).attr("data-num") == num) {
				$(el).addClass('showup').siblings().removeClass('showup');
			}
		}

		$(".map-box-close-btn").click(function() {
			console.log(123);
			$(this).parents('.map-box').removeClass('showup');
			$('.location-main').removeClass('active');
			$('body').removeClass('index-mask');
		});

	});
</script>
